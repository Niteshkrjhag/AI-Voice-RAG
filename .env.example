# ============================================================
# Production Voice AI + RAG — Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# ============================================================

# === Google Gemini (Primary LLM) ===
GOOGLE_API_KEY=your_google_gemini_api_key_here


# === Vapi (Voice Platform — Q1, Q3) ===
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# === Qdrant (Vector Database — Q2) ===
QDRANT_URL=your_qdrant_cluster_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=health_insurance_kb

# === AssemblyAI (Streaming ASR — Q4) ===
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# === Crawl4AI (Web Scraping — Q2) ===
# No API key needed — open source, runs locally


# === RAG API Security (Q1, Q2, Q3) ===
RAG_API_KEY=health-shield-secret-123

# === Application Settings ===
APP_ENV=development
LOG_LEVEL=INFO
RETRIEVAL_API_HOST=0.0.0.0
RETRIEVAL_API_PORT=8000
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
NGROK_URL=https://your-ngrok-url.ngrok.app


# === Embedding Config ===
# We use local SentenceTransformers (all-MiniLM-L6-v2) to avoid OpenAI bills
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
